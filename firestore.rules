rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes use the validated server API. The Admin SDK bypasses
    // rules; the API independently verifies active stored roles on every call.
    // Public endpoints project published records only. No browser access to PII.
    match /{document=**} { allow read, write: if false; }
  }
}
