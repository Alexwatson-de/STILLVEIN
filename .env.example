# Copy to .env.local. Never commit secrets. Dedicated project only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Build-time upload ceiling: 10 MB on unrestricted local hosts, 4 MB on Vercel.
# Set the same value for build and runtime so client/server validation agree.
NEXT_PUBLIC_MAX_IMAGE_MB=10
# Public Firebase web configuration (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Server only: JSON service account, OR application-default credentials on the host.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative local/server credential file; use an absolute path outside Git.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/stillvein-server.json
# Server only. Signed uploads; never prefix API secret with NEXT_PUBLIC_ or VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# REQUIRED for uploads: signed Cloudinary preset; image-only jpg/png/webp;
# unsigned=false, overwrite=false. Byte/pixel limits are enforced on the server,
# not in the preset: max_file_size is NOT a Cloudinary preset parameter.
CLOUDINARY_UPLOAD_PRESET=stillvein_signed
# Server-only random >=32-character secret, used for anonymous enquiry IP hashes.
RATE_LIMIT_SECRET=
# Set only behind a proxy that overwrites x-forwarded-for (e.g. trusted hosting).
TRUST_PROXY=false
# LOCAL ONLY: use demo-stillvein, never connect emulators to production.
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-stillvein
# FIREBASE_PROJECT_ID=demo-stillvein
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Local emulator provisioning accepts ADMIN_EMAIL and ADMIN_PASSWORD via shell only.
# Production provisioning creates an account but never assigns a default password.
# Optional: public support email and links are configured in the admin, not here.
